#!/usr/bin/env bash
# Git pre-commit hook, installed by `make tools` (do not edit the installed copy).
#
# Unlike the hook generated by `pre-commit install`, which hard-codes the absolute path of one
# virtualenv, this resolves pre-commit from the .venv of the worktree being committed to. Git
# worktrees share one hooks directory, so this keeps every worktree on its own pinned tools.
# PRE_COMMIT_HOME is kept inside .venv so nothing is written outside the repository.
set -euo pipefail

root=$(git rev-parse --show-toplevel)

if [ ! -f "$root/.pre-commit-config.yaml" ]; then
  echo "pre-commit hook: no .pre-commit-config.yaml in $root, skipping" >&2
  exit 0
fi

pre_commit="$root/.venv/bin/pre-commit"
if [ ! -x "$pre_commit" ]; then
  echo "pre-commit hook: $pre_commit not found. Run 'make tools' in $root first." >&2
  exit 1
fi

export PRE_COMMIT_HOME="$root/.venv/pre-commit-home"
cd "$root"
exec "$pre_commit" run --hook-stage pre-commit
